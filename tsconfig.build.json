{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* 🧱 Core build behavior */
    "rootDir": "./src",
    "outDir": "./dist",

    /* 🚀 Always emit .js output even with type errors */
    "noEmitOnError": false,
    "skipLibCheck": true,
    "incremental": false,

    /* 🩹 Relaxed checks to bypass strict null/type issues */
    "strict": false,
    "noImplicitAny": false,
    "allowUnreachableCode": true,
    "allowUnusedLabels": true,

    /* ⚙️ Compatibility + stability */
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],

    /* 🧯 Silence deprecation warnings for older flags */
    "ignoreDeprecations": "5.0"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "integration",
    "tests",
    "temporary",
    "**/*.test.ts"
  ],
  "files": [],
  "compileOnSave": false
}
