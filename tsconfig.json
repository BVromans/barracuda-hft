{
  "compilerOptions": {
    /* 🧱 Core structure */
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "rootDir": "./src",
    "outDir": "./dist",

    /* ⚙️ Compatibility */
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node"],

    /* 🩹 Type safety (relaxed to prevent blocking builds) */
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "allowUnreachableCode": true,
    "allowUnusedLabels": true,

    /* 🧩 Other flags */
    "experimentalDecorators": true,
    "sourceMap": true,
    "incremental": false,
    "noEmitOnError": false,
    "ignoreDeprecations": "5.0"
  },

  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "integration",
    "tests",
    "temporary",
    "**/*.test.ts"
  ]
}
