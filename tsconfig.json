{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "node",
		"lib": ["ESNext"],
		"strict": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"outDir": "dist",
		"rootDir": ".",
		"skipLibCheck": true,
		"types": ["bun-types"]
	},
	"include": ["src", "integration", "tests", "temporary/playground"],
	"exclude": ["node_modules", "dist"]
}
