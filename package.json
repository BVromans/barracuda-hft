{
    "name": "rujira-hft-bot",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "dev": "NODE_ENV=development bun run --inspect=9222 src/index.ts",
        "build": "bun build src/index.ts --outdir dist",
        "start": "NODE_ENV=production bun run src/index.ts",
        "test:unit": "bun test --inspect=9222 tests/index.test.ts",
        "test:integration": "bun test --inspect=9222 integration/index.test.ts",
        "playground:01": "NODE_ENV=development bun run --inspect=9222 temporary/playground/01.ts",
        "playground:02": "NODE_ENV=development bun run --inspect=9222 temporary/playground/02.ts",
        "playground:03": "NODE_ENV=development bun run --inspect=9222 temporary/playground/03.ts",
        "playground:04": "NODE_ENV=development bun run --inspect=9222 temporary/playground/04.ts",
        "playground:05": "NODE_ENV=development bun run --inspect=9222 temporary/playground/05.ts",
        "playground:06": "NODE_ENV=development bun run --inspect=9222 temporary/playground/06.ts",
        "playground:07": "NODE_ENV=development bun run --inspect=9222 temporary/playground/07.ts",
        "logs:list": "bun run src/utils/logViewer.ts",
        "logs:view": "bun run src/utils/logViewer.ts"
    },
    "dependencies": {
        "@cosmjs/cosmwasm-stargate": "^0.33.1",
        "@cosmjs/proto-signing": "^0.33.1",
        "@cosmjs/stargate": "^0.33.1",
        "decimal.js": "^10.5.0",
        "dotenv": "latest",
        "memo-decorator": "^2.0.1"
    },
    "devDependencies": {
        "@types/bn.js": "^5.1.6",
        "@types/node": "latest",
        "bun-types": "^1.2.16"
    }
}
