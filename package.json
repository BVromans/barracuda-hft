{
    "name": "rujira-hft-bot",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "dev": "NODE_ENV=development bun run --inspect=9222 src/index.ts",
        "build": "bun build src/index.ts --outdir dist",
        "start": "NODE_ENV=production bun run src/index.ts",
				"demonstration": "NODE_ENV=production bun run src/demonstration.ts",
        "test:unit": "bun test --inspect=9222 tests/index.test.ts",
        "test:integration": "bun test --inspect=9222 integration/index.test.ts",
        "playground": "NODE_ENV=development bun run --inspect=9222 temporary/playground/immutable.ts"
    },
    "dependencies": {
        "@cosmjs/cosmwasm-stargate": "^0.33.1",
        "@cosmjs/proto-signing": "^0.33.1",
        "@cosmjs/stargate": "^0.33.1",
        "@ixjb94/indicators-js": "^1.0.0",
        "@type-cacheable/core": "^14.1.0",
        "@type-cacheable/lru-cache-adapter": "^18.0.0",
        "decimal.js": "^10.5.0",
        "dotenv": "latest",
        "extendable-immutable": "^1.3.3",
        "immutable": "^5.1.3",
        "lru-cache": "^11.1.0",
        "reflect-metadata": "^0.2.2",
        "yaml": "^2.8.0"
    },
    "devDependencies": {
        "@types/bn.js": "^5.1.6",
        "@types/node": "latest",
        "bun-types": "^1.2.16"
    }
}
