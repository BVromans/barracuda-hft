{
  "name": "barracuda-hft",
  "version": "8.0.0",
  "description": "TCY Bot v8 – Value-Anchored Trading Engine for Rujira (Synology NAS build, TypeScript + SQLite).",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build:node": "tsc --project tsconfig.build.json --skipLibCheck --noEmitOnError false --pretty",
    "build:clean": "rm -rf dist .tsbuildinfo && npm run build:node",
    "build": "./node_modules/.bin/tsc --project tsconfig.json",
    "start:node": "NODE_ENV=development /usr/local/bin/node -r dotenv/config dist/index.js dotenv_config_path=/volume1/tcy-bot/barracuda-hft-v8/.env",
    "dev:node": "NODE_ENV=development ./node_modules/.bin/ts-node -r dotenv/config src/index.ts dotenv_config_path=/volume1/tcy-bot/barracuda-hft-v8/.env",
    "clean": "rm -rf dist dist-test .tsbuildinfo",
    "lint": "echo 'Linting skipped (no linter configured)'",
    "test:db": "./node_modules/.bin/tsc test-db.ts --target ES2020 --module CommonJS --outDir dist-test && /usr/local/bin/node dist-test/test-db.js",
    "test:db:clean": "./node_modules/.bin/tsc test-db-clean.ts --target ES2020 --module CommonJS --outDir dist-test && /usr/local/bin/node dist-test/test-db-clean.js",
    "start:fills": "NODE_ENV=production node dist/helpers/rujira_fills.js",
    "start:orders": "NODE_ENV=production node dist/helpers/rujira_orders.js",
    "start:watchers": "NODE_ENV=production sh -c 'node dist/helpers/rujira_orders.js & node dist/helpers/rujira_fills.js'"
  },
  "dependencies": {
    "@cosmjs/cosmwasm-stargate": "^0.33.1",
    "@cosmjs/proto-signing": "^0.33.1",
    "@cosmjs/stargate": "^0.33.1",
    "@ixjb94/indicators-js": "^1.0.0",
    "@type-cacheable/core": "^14.1.0",
    "@type-cacheable/lru-cache-adapter": "^18.0.0",
    "@types/node-fetch": "^2.6.13",
    "decimal.js": "^10.5.0",
    "dotenv": "^16.4.5",
    "extendable-immutable": "^1.3.3",
    "immutable": "^5.1.3",
    "lru-cache": "^11.1.0",
    "node-fetch": "^2.7.0",
    "node-telegram-bot-api": "^0.66.0",
    "reflect-metadata": "^0.2.2",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.6",
    "@types/node": "^20.14.11",
    "@types/node-telegram-bot-api": "^0.64.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "hft",
    "rujira",
    "barracuda",
    "tcy",
    "value-anchored",
    "papertrading",
    "sqlite",
    "synology"
  ],
  "author": "Funttastic (adapted for TCY Bot by user)",
  "license": "MIT"
}
